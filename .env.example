# ==============================================================================
# Antigravity CLI Container Environment Configuration
# ==============================================================================

# User ID and Group ID (99 and 100 match Unraid nobody:users)
PUID=99
PGID=100

# Container timezone
TZ=America/New_York

# Instance name displayed in Antigravity Remote
ANTIGRAVITY_INSTANCE_NAME=unraid-server

# Daemon auto-start on boot (true/false)
AUTO_START_DAEMON=true

# Check for and install Google CLI updates automatically (true/false)
AUTO_UPDATE=true

# Host paths on Unraid or Linux server
APP_DATA_DIR=/mnt/user/appdata/antigravity
PROJECTS_DIR=/mnt/user/projects
